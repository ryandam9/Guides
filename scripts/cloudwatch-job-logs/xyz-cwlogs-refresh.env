# Installed as /etc/default/xyz-cwlogs-refresh
#
# Directory containing application job logs.
LOG_DIR="/app/xyz/log"

# Shared CloudWatch Logs log group.
LOG_GROUP="/app/xyz/jobs"

# 0 = include every supported *.log file currently present.
# Set a positive value only if old files accumulate locally and the chosen
# window is safely longer than any period in which a job can remain inactive
# and later continue writing to the same file.
#
# Example: 2880 = approximately 48 hours.
MAX_FILE_AGE_MINUTES=0

# Normally these do not need changing.
CW_AGENT_CTL="/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl"
CW_AGENT_CONFIG_DIR="/opt/aws/amazon-cloudwatch-agent/etc"
GENERATED_CONFIG_NAME="xyz-job-logs.json"
LOCK_DIR="/run/xyz-cwlogs-refresh.lock"
